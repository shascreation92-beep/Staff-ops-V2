generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model account {
  id                             String           @id
  platformId                     String
  serialCode                     String           @unique(map: "Account_serialCode_key")
  idName                         String
  adsPublished                   Int              @default(0)
  verificationStatus             String           @default("No")
  status                         account_status   @default(DRAFT)
  associateId                    String?
  itNotes                        String?          @db.Text
  comment                        String?          @db.Text
  issueType                      String?          @default("Active")
  isArchived                     Boolean          @default(false)
  archivedAt                     DateTime?
  archivedBy                     String?
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime
  companyId                      String
  createdById                    String
  updatedById                    String
  teamLeadId                     String?
  company                        company          @relation(fields: [companyId], references: [id], map: "Account_companyId_fkey")
  user_account_createdByIdTouser user             @relation("account_createdByIdTouser", fields: [createdById], references: [id], map: "Account_createdById_fkey")
  platform                       platform         @relation(fields: [platformId], references: [id], map: "Account_platformId_fkey")
  user_account_updatedByIdTouser user             @relation("account_updatedByIdTouser", fields: [updatedById], references: [id], map: "Account_updatedById_fkey")
  accounthistory                 accounthistory[]

  @@index([companyId], map: "Account_companyId_fkey")
  @@index([createdById], map: "Account_createdById_fkey")
  @@index([platformId], map: "Account_platformId_fkey")
  @@index([updatedById], map: "Account_updatedById_fkey")
  @@index([companyId, status, isArchived])
  @@index([companyId, teamLeadId, status])
}

model accounthistory {
  id          String                     @id
  accountId   String
  fromStatus  accounthistory_fromStatus?
  toStatus    accounthistory_toStatus
  changedById String
  notes       String?                    @db.Text
  createdAt   DateTime                   @default(now())
  account     account                    @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "AccountHistory_accountId_fkey")
  user        user                       @relation(fields: [changedById], references: [id], map: "AccountHistory_changedById_fkey")

  @@index([accountId], map: "AccountHistory_accountId_fkey")
  @@index([changedById], map: "AccountHistory_changedById_fkey")
}

model announcement {
  id          String    @id
  title       String
  content     String    @db.Text
  createdById String
  companyId   String?
  isArchived  Boolean   @default(false)
  archivedAt  DateTime?
  archivedBy  String?
  createdAt   DateTime  @default(now())
  company     company?  @relation(fields: [companyId], references: [id], map: "Announcement_companyId_fkey")
  user        user      @relation(fields: [createdById], references: [id], onDelete: Cascade, map: "Announcement_createdById_fkey")

  @@index([companyId], map: "Announcement_companyId_fkey")
  @@index([createdById], map: "Announcement_createdById_fkey")
}

model auditlog {
  id        String   @id
  userId    String?
  userEmail String?
  userRole  String?
  action    String
  entity    String
  entityId  String?
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  ipAddress String?
  country   String?
  createdAt DateTime @default(now())
  user      user?    @relation(fields: [userId], references: [id], map: "AuditLog_userId_fkey")

  @@index([userId], map: "AuditLog_userId_fkey")
}

model chatmessage {
  id                                String    @id
  senderId                          String
  receiverId                        String
  message                           String    @db.Text
  isRead                            Boolean   @default(false)
  readAt                            DateTime?
  createdAt                         DateTime  @default(now())
  user_chatmessage_receiverIdTouser user      @relation("chatmessage_receiverIdTouser", fields: [receiverId], references: [id], onDelete: Cascade, map: "ChatMessage_receiverId_fkey")
  user_chatmessage_senderIdTouser   user      @relation("chatmessage_senderIdTouser", fields: [senderId], references: [id], onDelete: Cascade, map: "ChatMessage_senderId_fkey")

  isForwarded                       Boolean   @default(false)
  isEdited                          Boolean   @default(false)
  editedAt                          DateTime?
  isDeleted                         Boolean   @default(false)
  reactions                         String?   @db.Text

  replyToId                         String?
  replyToSenderId                   String?
  replyToSenderName                 String?
  replyToMessage                    String?   @db.Text

  @@index([receiverId], map: "ChatMessage_receiverId_fkey")
  @@index([senderId], map: "ChatMessage_senderId_fkey")
  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
}

model company {
  id            String         @id
  name          String
  website       String?
  ownerName     String?
  ownerEmail    String?
  logo          String?
  industry      String?
  country       String?
  employeeCount Int?
  status        company_status @default(PENDING)
  isArchived    Boolean        @default(false)
  archivedAt    DateTime?
  archivedBy    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  account       account[]
  announcement  announcement[]
  employee      employee[]
  platform      platform[]
  rule          rule[]
  user          user[]
  chatgroup     chatgroup[]
  specialrequest specialrequest[]
  tenanttrendsconfig tenanttrendsconfig?
  leaverequest   leaverequest[]
}

model employee {
  id                 String                   @id
  employeeId         String                   @unique(map: "Employee_employeeId_key")
  fullName           String
  email              String                   @unique(map: "Employee_email_key")
  status             String                   @default("ACTIVE")
  laptopBrand        employee_laptopBrand?
  laptopModel        String?
  laptopSerialNumber String?
  windowsVersion     employee_windowsVersion?
  vpnProvider        employee_vpnProvider?
  isArchived         Boolean                  @default(false)
  archivedAt         DateTime?
  archivedBy         String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime
  companyId          String
  userId             String?                  @unique(map: "Employee_userId_key")
  laptopPassword     String?
  vpnCredentials     String?
  company            company                  @relation(fields: [companyId], references: [id], map: "Employee_companyId_fkey")
  user               user?                    @relation(fields: [userId], references: [id], map: "Employee_userId_fkey")

  @@index([companyId], map: "Employee_companyId_fkey")
}

model loginlog {
  id            String    @id
  userId        String
  loginTime     DateTime  @default(now())
  logoutTime    DateTime?
  browser       String?
  device        String?
  ipAddress     String?
  country       String?
  sessionLength Int?
  createdAt     DateTime  @default(now())
  user          user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "LoginLog_userId_fkey")

  @@index([userId], map: "LoginLog_userId_fkey")
}

model notification {
  id         String   @id
  userId     String
  title      String
  message    String
  type       String
  isRead     Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")

  @@index([userId], map: "Notification_userId_fkey")
}

model platform {
  id         String    @id
  name       String
  companyId  String?
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  account    account[]
  company    company?  @relation(fields: [companyId], references: [id], map: "Platform_companyId_fkey")

  @@unique([name, companyId], map: "Platform_name_companyId_key")
  @@index([companyId], map: "Platform_companyId_fkey")
}

model rule {
  id        String   @id
  name      String
  key       String
  value     String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime
  company   company  @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "Rule_companyId_fkey")

  @@unique([key, companyId], map: "Rule_key_companyId_key")
  @@index([companyId], map: "Rule_companyId_fkey")
}

model user {
  id                                       String           @id
  name                                     String?
  email                                    String           @unique(map: "User_email_key")
  emailVerified                            DateTime?
  image                                    String?          @db.MediumText
  role                                     user_role        @default(SALES_ASSOCIATE)
  status                                   user_status      @default(PENDING)
  companyId                                String?
  isArchived                               Boolean          @default(false)
  archivedAt                               DateTime?
  archivedBy                               String?
  createdAt                                DateTime         @default(now())
  updatedAt                                DateTime
  teamLeadId                               String?
  lastActiveAt                             DateTime?
  password                                 String?
  isDnd                                    Boolean          @default(false)
  bio                                      String?          @db.Text
  dutyStatus                               String           @default("OFF_DUTY")
  shiftduty                                shiftduty[]
  account_account_createdByIdTouser        account[]        @relation("account_createdByIdTouser")
  account_account_updatedByIdTouser        account[]        @relation("account_updatedByIdTouser")
  accounthistory                           accounthistory[]
  announcement                             announcement[]
  auditlog                                 auditlog[]
  chatmessage_chatmessage_receiverIdTouser chatmessage[]    @relation("chatmessage_receiverIdTouser")
  chatmessage_chatmessage_senderIdTouser   chatmessage[]    @relation("chatmessage_senderIdTouser")
  employee                                 employee?
  loginlog                                 loginlog[]
  notification                             notification[]
  company                                  company?         @relation(fields: [companyId], references: [id], map: "User_companyId_fkey")
  user                                     user?            @relation("userTouser", fields: [teamLeadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "User_teamLeadId_fkey")
  other_user                               user[]           @relation("userTouser")
  personalnote                             personalnote[]
  chatpin                                  chatpin[]
  chatgroupmember                          chatgroupmember[]
  chatgroupmessage                         chatgroupmessage[]
  chatgroup_created                        chatgroup[]      @relation("group_createdBy")
  chatstar                                 chatstar[]
  chatjoinrequest                          chatjoinrequest[]
  specialrequest                           specialrequest[]
  pushsubscription                         pushsubscription[]
  leaverequest                             leaverequest[]

  @@index([companyId], map: "User_companyId_fkey")
  @@index([teamLeadId], map: "User_teamLeadId_fkey")
}

enum accounthistory_fromStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED_BY_TEAM_LEAD
  ASSIGNED_TO_IT
  IN_PROGRESS
  COMPLETED
  ACTIVE
  REJECTED
  PENDING_TL
  FORWARDED_TO_IT
  IT_PENDING
  SORTED
}

enum accounthistory_toStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED_BY_TEAM_LEAD
  ASSIGNED_TO_IT
  IN_PROGRESS
  COMPLETED
  ACTIVE
  REJECTED
  PENDING_TL
  FORWARDED_TO_IT
  IT_PENDING
  SORTED
}

enum employee_laptopBrand {
  HP
  Dell
  ThinkPad
}

enum user_role {
  SUPER_ADMIN
  COMPANY_OWNER
  TEAM_LEAD
  SALES_ASSOCIATE
  IT_DEPARTMENT
}

enum account_status {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED_BY_TEAM_LEAD
  ASSIGNED_TO_IT
  IN_PROGRESS
  COMPLETED
  ACTIVE
  REJECTED
  PENDING_TL
  FORWARDED_TO_IT
  IT_PENDING
  SORTED
}

enum user_status {
  PENDING
  APPROVED
  BLOCKED
  REJECTED
}

enum employee_windowsVersion {
  Windows_10
  Windows_11
}

enum company_status {
  PENDING
  APPROVED
  BLOCKED
  ARCHIVED
}

enum employee_vpnProvider {
  Surfshark
  ExpressVPN
  NordVPN
  ProtonVPN
  PureVPN
  HideMe
}

model personalnote {
  id                   String   @id @default(uuid())
  userId               String
  title                String
  content              String   @db.Text
  isPinned             Boolean  @default(false)
  color                String   @default("default")
  isChecklist          Boolean  @default(false)
  isSharedAnnouncement Boolean   @default(false)
  isSharedByMe         Boolean   @default(false)
  isGlobalPinned       Boolean   @default(false)
  timerExpiresAt       DateTime?
  isAcknowledged       Boolean   @default(false)
  sharedFromTlName     String?
  sharedFromNoteId     String?
  category             String?   @default("Work")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "PersonalNote_userId_fkey")
  @@map("personal_notes")
}

model chatgroup {
  id          String             @id
  name        String
  isPrivate   Boolean            @default(false)
  companyId   String
  createdById String
  createdAt   DateTime           @default(now())
  company     company            @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "ChatGroup_companyId_fkey")
  createdBy   user               @relation("group_createdBy", fields: [createdById], references: [id], onDelete: Cascade, map: "ChatGroup_createdById_fkey")
  members     chatgroupmember[]
  messages    chatgroupmessage[]
  joinRequests chatjoinrequest[]

  @@index([companyId], map: "ChatGroup_companyId_fkey")
  @@index([createdById], map: "ChatGroup_createdById_fkey")
}

model chatgroupmember {
  id       String    @id
  groupId  String
  userId   String
  joinedAt DateTime  @default(now())
  group    chatgroup @relation(fields: [groupId], references: [id], onDelete: Cascade, map: "ChatGroupMember_groupId_fkey")
  user     user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ChatGroupMember_userId_fkey")

  @@unique([groupId, userId], map: "ChatGroupMember_groupId_userId_key")
  @@index([groupId], map: "ChatGroupMember_groupId_fkey")
  @@index([userId], map: "ChatGroupMember_userId_fkey")
}

model chatgroupmessage {
  id        String    @id
  groupId   String
  senderId  String
  message   String    @db.Text
  createdAt DateTime  @default(now())
  group     chatgroup @relation(fields: [groupId], references: [id], onDelete: Cascade, map: "ChatGroupMessage_groupId_fkey")
  sender    user      @relation(fields: [senderId], references: [id], onDelete: Cascade, map: "ChatGroupMessage_senderId_fkey")

  isForwarded                       Boolean   @default(false)
  isEdited                          Boolean   @default(false)
  editedAt                          DateTime?
  isDeleted                         Boolean   @default(false)
  reactions                         String?   @db.Text

  replyToId                         String?
  replyToSenderId                   String?
  replyToSenderName                 String?
  replyToMessage                    String?   @db.Text

  @@index([groupId], map: "ChatGroupMessage_groupId_fkey")
  @@index([senderId], map: "ChatGroupMessage_senderId_fkey")
}

model chatpin {
  id        String   @id
  userId    String
  targetId  String
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ChatPin_userId_fkey")

  @@unique([userId, targetId], map: "ChatPin_userId_targetId_key")
  @@index([userId], map: "ChatPin_userId_fkey")
}

model chatstar {
  id              String   @id
  userId          String
  messageId       String?
  groupMessageId  String?
  createdAt       DateTime @default(now())
  user            user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ChatStar_userId_fkey")

  @@unique([userId, messageId], map: "ChatStar_userId_messageId_key")
  @@unique([userId, groupMessageId], map: "ChatStar_userId_groupMessageId_key")
  @@index([userId], map: "ChatStar_userId_fkey")
}

model chatjoinrequest {
  id        String    @id
  groupId   String
  userId    String
  status    String    @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime  @default(now())
  group     chatgroup @relation(fields: [groupId], references: [id], onDelete: Cascade, map: "ChatJoinRequest_groupId_fkey")
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ChatJoinRequest_userId_fkey")

  @@unique([groupId, userId], map: "ChatJoinRequest_groupId_userId_key")
  @@index([groupId], map: "ChatJoinRequest_groupId_fkey")
  @@index([userId], map: "ChatJoinRequest_userId_fkey")
}

model specialrequest {
  id          String   @id
  companyId   String
  requesterId String
  title       String
  description String   @db.Text
  category    String   // "IT" or "COMPANY"
  status      String   @default("PENDING") // "PENDING", "IN_PROGRESS", "RESOLVED", "REJECTED"
  priority    String   @default("MEDIUM")  // "LOW", "MEDIUM", "HIGH", "URGENT"
  notes       String?  @db.Text
  ccUserIds   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     company  @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "SpecialRequest_companyId_fkey")
  requester   user     @relation(fields: [requesterId], references: [id], onDelete: Cascade, map: "SpecialRequest_requesterId_fkey")

  @@index([companyId], map: "SpecialRequest_companyId_fkey")
  @@index([requesterId], map: "SpecialRequest_requesterId_fkey")
}

model uktrend {
  id               String   @id
  keyword          String
  traffic          String
  spikePercent     Int
  newsUrl          String   @db.Text
  newsTitle        String   @db.Text
  newsSource       String
  category         String   // "BEDS", "SOFAS", "WARDROBES", "GENERAL"
  source           String   @default("GOOGLE") // "GOOGLE", "FACEBOOK", "VINTED", "EBAY"
  postcode         String?  // Scoped localized postcode
  apparelSize      String?  // Size for Vinted trends
  apparelCondition String?  // Condition for Vinted trends
  createdAt        DateTime @default(now())
}

model tenanttrendsconfig {
  id              String   @id
  companyId       String   @unique
  defaultCategory String   @default("ALL")
  notes           String?  @db.Text
  updatedAt       DateTime @updatedAt
  company         company  @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "TenantTrendsConfig_companyId_fkey")
}

model itparsedaccount {
  id           String   @id
  seriesNumber String
  password     String
  name         String
  createdAt    DateTime @default(now())
  agentId      String
  companyId    String
  color        String?
  remarks      String?  @db.Text
}

model pushsubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model contactsubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model leaverequest {
  id               String    @id @default(uuid())
  userId           String
  companyId        String
  teamLeadId       String?
  leaveType        String    // "SICK", "CASUAL", "EMERGENCY", "FAMILY"
  startDate        DateTime
  endDate          DateTime
  totalDays        Int
  reason           String    @db.Text
  emergencyContact String?
  status           String    @default("PENDING_TL") // "PENDING_TL", "PENDING_COMPANY", "APPROVED", "REJECTED"
  tlNotes          String?   @db.Text
  tlActionAt       DateTime?
  companyNotes     String?   @db.Text
  companyActionAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([teamLeadId])
  @@index([companyId, status])
  @@index([teamLeadId, status])
}

model shiftduty {
  id             String    @id @default(uuid())
  userId         String
  companyId      String?
  status         String    @default("ON_DUTY") // "ON_DUTY", "ON_BREAK", "OFF_DUTY"
  clockInTime    DateTime  @default(now())
  breakStartTime DateTime?
  clockOutTime   DateTime?
  notes          String?   @db.Text
  totalMinutes   Int?      @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([status])
}
